# Copier ce fichier en .env (non versionné) puis adapter si besoin.
# Valeur alignée sur docker-compose.yml à la racine du projet.
# 127.0.0.1 plutôt que localhost : Docker n'écoute qu'en IPv4, cela évite un essai IPv6 inutile.
DATABASE_URL=postgresql+psycopg://stationalerte:stationalerte@127.0.0.1:5432/stationalerte
# true en production (HTTPS) : cookie de session « Secure » avec le préfixe __Host-. false en local (http).
COOKIE_SECURE=false
# E-mails : en local, Mailpit (docker-compose.yml) les capture, à lire sur http://localhost:8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=StationAlerte <noreply@stationalerte.local>
# Rythme de vérification du flux officiel par le surveillant (app/worker.py), en minutes : 10 au minimum.
CHECK_EVERY_MINUTES=10
# Adresse du site, utilisée dans les liens envoyés par e-mail.
FRONTEND_URL=http://localhost:5173
# Espace de démonstration en bas du site (changer l'état de la station fictive stationTest, sans compte).
# Local uniquement : false (ou absent) sur un site public.
DEMO_MODE=true
